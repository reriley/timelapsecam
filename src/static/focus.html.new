<!DOCTYPE html>
<html lang="en">
<head>
<title>Camera Focus Tool</title>
<script>
    window.onload = function() {
        var source = new EventSource("/focus_stream");
        const canvas = document.getElementById("canvas");
        const ctx = canvas.getContext("2d");
        source.onmessage = function(event) {
        	var data = JSON.parse(event.data);
            document.getElementById("lvar").innerHTML = data.lvar.toFixed(2);
            document.getElementById("lvar_max").innerHTML = data.lvar_max.toFixed(2);

			const delta = Math.abs(data.lvar - data.lvar_max);
            const x = 150; // x coordinate
            const y = 150; // y coordinate
            const radius_dot = 75 - delta; // Arc radius
            const radius_circle = 75 + delta; // Arc radius
            const startAngle = 0; // Starting point on circle
            const endAngle = 2 * Math.PI; // End point on circle
            const counterclockwise = 0; // clockwise or counterclockwise
            
			ctx.clearRect(0, 0, 300, 300);
			ctx.lineWidth = 5;
			ctx.beginPath();
            ctx.arc(x, y, radius_dot, startAngle, endAngle, counterclockwise);
			ctx.stroke();
			ctx.beginPath();
            ctx.arc(x, y, radius_circle, startAngle, endAngle, counterclockwise);
			ctx.stroke();
        };
    };
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400..900&display=swap" rel="stylesheet">
<style>

	html, body {
		font-family: "Orbitron", sans-serif, monospace;
		font-size: x-large;
		font-optical-sizing: auto;
		font-weight: 900;
		font-style: normal;
		color: black;
		background-color: white;
		height: 100%;
		max-height: 100%;
	}

	.main {
	    height: 70%;
	    width: 100%;
	    display: table;
	}
	.wrapper {
	    display: table-cell;
	    height: 100%;
	    vertical-align: middle;
	}

	h {
		font-size: xx-large;
	}

	p {
		margin: 0 0;
		color: black;
	}

	p.label {
		font-size: small;
		font-weight: 400;
	}

	p.small-label {
		font-size: xx-small;
		font-weight: 400;
	}

	a {
		font-size: small;
	}

	a:link {
	}
	
	a:visited {
		color: black;
	}
	
	a:focus {
	}
	
	a:hover {
		color: grey;
	}
	
	a:active {
	}

	hr {
	    display: blo	ck;
	    height: 0px;
	    border: 0;
	    border-top: 5px solid black;
	    margin: 0 0;
	    padding: 0;
	    width: 1em;
	}

	.data {
		font-size: x-large;
		font-optical-sizing: auto;
	}

	#canvas-container {
	   width: 100%;
	   text-align:center;
	}

	canvas {
	   display: inline;
	   <!-- position: absolute; -->
	   height: 300px;
	   width: 300px;
		<!-- top: 0; -->
 	<!--     left: 0; -->
	}
</style>
</head>
<body>
	<center>
		<h>Camera Focus Tool</h><p/>
		<a href="/">Live Feed<a/>
	</center>
	<div class = "main"><div class = "wrapper">
	    <div id="canvas-container">
		    <canvas id="canvas">
	    	    <!--Server response will be inserted here-->
	    	</canvas>
	    </div>
	    <center id="metrics" class=data>
	    	<p class="label">Laplacian Variance</p>
			<p id="lvar"></p>
			<hr/>
			<p id="lvar_max"></p>
			<p class="small-label">RECENT MAX<p>
	    </center>
    </div></div>
</body>
</html>
